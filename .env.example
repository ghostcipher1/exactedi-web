# Public site URL (canonical links, sitemap, JSON-LD)
VITE_SITE_URL=https://exactedi.com

# --- Recommended: direct GA4 (no Tag Manager) — see ANALYTICS_SETUP.md Option A ---
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_USE_GTM=false

# --- Alternative: Google Tag Manager (Option B) ---
# VITE_GTM_ID=GTM-522ZBZWZ
# VITE_USE_GTM=true

# VITE_ENABLE_ANALYTICS=false

# Vercel serverless lead capture (set in Vercel dashboard, not needed locally)
# RESEND_API_KEY=
# LEADS_TO_EMAIL=contact@exactedi.com
# RESEND_FROM_EMAIL=ExactEDI <onboarding@resend.dev>
# LEADS_WEBHOOK_URL=

# Supabase (blog — optional until you migrate to local MDX)
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=
